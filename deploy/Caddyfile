{
	# HTTP/3 desligado de propósito. O Caddy o anuncia por padrão via Alt-Svc, mas
	# QUIC precisa de UDP 443 — que o docker-compose não publica e a rede da Oracle
	# não libera. O navegador acreditava no anúncio, tentava por UDP, não achava
	# ninguém e mostrava "This page couldn't load", guardando isso por 30 dias.
	# Para religar um dia: publicar "443:443/udp" no compose E liberar UDP 443 na VCN.
	servers {
		protocols h1 h2
	}
}

168-138-141-214.sslip.io {
	# Manda o navegador esquecer o anúncio de HTTP/3 que ele já guardou. Sem isso,
	# quem visitou antes continuaria tentando QUIC por até 30 dias.
	header Alt-Svc "clear"

	reverse_proxy backend:3001 {
		# Durante uma publicação o container reinicia. Em vez de devolver erro
		# na hora, o Caddy segura a requisição e tenta de novo até voltar.
		lb_try_duration 30s
		lb_try_interval 500ms
	}

	# Se mesmo assim não voltar a tempo, mostra uma página de espera em vez do
	# erro do navegador. Fica aqui, e não no backend, porque o Caddy é a única
	# peça que continua de pé enquanto os outros containers reiniciam.
	handle_errors {
		@fora expression {err.status_code} in [502, 503, 504]
		header @fora Retry-After 5
		header @fora Cache-Control no-store
		respond @fora <<HTML
			<!doctype html>
			<html lang="pt-BR"><head><meta charset="utf-8">
			<meta name="viewport" content="width=device-width,initial-scale=1">
			<title>Guará</title>
			<meta http-equiv="refresh" content="3">
			<style>
			  body { margin:0; min-height:100vh; display:grid; place-items:center;
			         background:#efe3d2; color:#191007; text-align:center; padding:1.5rem;
			         font-family: system-ui, -apple-system, sans-serif; }
			  @media (prefers-color-scheme: dark) { body { background:#14100b; color:#f7efe2; } }
			  h1 { font-size:1.6rem; margin:0 0 .6rem; }
			  p { margin:0; font-size:1.05rem; opacity:.75; line-height:1.5; max-width:22rem; }
			  .rodela { width:2.5rem; height:2.5rem; margin:0 auto 1.5rem; border-radius:50%;
			            border:4px solid rgba(196,64,13,.25); border-top-color:#c4400d;
			            animation: girar .9s linear infinite; }
			  @keyframes girar { to { transform: rotate(360deg); } }
			  @media (prefers-reduced-motion: reduce) { .rodela { animation-duration: 3s; } }
			</style></head>
			<body><div>
			  <div class="rodela"></div>
			  <h1>Já volto 🐺</h1>
			  <p>Estou aplicando uma atualização. Esta página se recarrega sozinha em alguns segundos.</p>
			</div></body></html>
			HTML 503
	}
}
